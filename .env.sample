# Peeko webhook verification
# Copy to .env — read by both the server (make dev) and tools/run-hurl.sh (make run-hurl).
# An empty WEBHOOK_SECRET disables signature verification.

# Generate one with: openssl rand -base64 32
WEBHOOK_SECRET=

# Optional — defaults shown. The hurl test always signs with the
# X-Webhook-Signature / X-Webhook-Timestamp headers over "<timestamp>.<body>",
# so only change these if you also update tools/_hurl/webhook.hurl.
#WEBHOOK_SIGNATURE_HEADER=X-Webhook-Signature
#WEBHOOK_TIMESTAMP_HEADER=X-Webhook-Timestamp
#WEBHOOK_SIGNATURE_ENCODING=hex        # hex | base64
#WEBHOOK_SIGNATURE_PREFIX=             # e.g. "sha256=" or "v1,"
#WEBHOOK_TOLERANCE=5m
